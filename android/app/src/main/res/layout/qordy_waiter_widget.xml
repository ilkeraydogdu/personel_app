<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_waiter_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_bg_dark"
    android:padding="14dp">

    <!-- Header: Title & Pulse / Time -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="🛎️ QORDY GARSON"
            android:textColor="#F8FAFC"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/waiter_widget_sync_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Canlı • --:--"
            android:textColor="#38BDF8"
            android:textSize="10sp"
            android:textStyle="bold" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#334155"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="10dp" />

    <!-- 2 Metric Boxes -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center">

        <!-- Bekleyen Çağrılar -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/widget_alert_box"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="8dp"
            android:layout_marginEnd="8dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🔔 BEKLEYEN ÇAĞRI"
                android:textColor="#FCA5A5"
                android:textSize="10sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/waiter_widget_pending_calls"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0"
                android:textColor="#EF4444"
                android:textSize="22sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Dolu Masa -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/widget_stat_box"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="8dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🍽️ DOLU MASA"
                android:textColor="#94A3B8"
                android:textSize="10sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/waiter_widget_active_tables"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0"
                android:textColor="#10B981"
                android:textSize="22sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <!-- Recent Call or Event Ticker -->
    <TextView
        android:id="@+id/waiter_widget_last_event"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Son Çağrı: Tüm masalar sakin ✨"
        android:textColor="#CBD5E1"
        android:textSize="11sp"
        android:maxLines="1"
        android:ellipsize="end" />
</LinearLayout>
